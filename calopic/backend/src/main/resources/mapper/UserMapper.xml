<!-- src/main/resources/mappers/user/UserMapper.xml -->
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="fs.human.calopic.user.dao.UserDAO">

    <resultMap id="UserMap" type="fs.human.calopic.user.vo.UserVO">
        <id     column="USER_ID"        property="id"/>
        <result column="USER_NAME"      property="userName"/>
        <result column="USER_PASSWORD"  property="userPassword"/>
        <result column="IS_ADMIN"       property="isAdmin"/>
        <result column="USER_QUESTION"  property="userQuestion"/>
        <result column="USER_ANSWER"    property="userAnswer"/>
        <result column="CREATED_DATE"    property="createdDate"/>
        <result column="CREATED_ID"      property="createdId"/>
        <result column="UPDATED_DATE"    property="updatedDate"/>
        <result column="UPDATED_ID"      property="updatedId"/>
    </resultMap>

    <select id="existsByUserName" resultType="int">
        SELECT CASE WHEN COUNT(1) > 0 THEN 1 ELSE 0 END
        FROM TB_USER
        WHERE USER_NAME = #{userName}
    </select>

    <select id="findByUserName" resultMap="UserMap">
        SELECT
        USER_ID, USER_NAME, USER_PASSWORD, IS_ADMIN,
        USER_QUESTION, USER_ANSWER,
        CREATED_DATE, CREATED_ID, UPDATED_DATE, UPDATED_ID
        FROM TB_USER
        WHERE USER_NAME = #{userName}
    </select>

    <!-- PK는 TRIGGER(TRG_TB_USER_BI)에서 채움 -->
    <insert id="insertUser">
        INSERT INTO TB_USER (
        USER_NAME, USER_PASSWORD, IS_ADMIN,
        USER_QUESTION, USER_ANSWER,
        CREATED_DATE, UPDATED_DATE
        ) VALUES (
        #{userName}, #{userPassword}, #{isAdmin},
        #{userQuestion}, #{userAnswer},
        SYSDATE, SYSDATE
        )
    </insert>

</mapper>
