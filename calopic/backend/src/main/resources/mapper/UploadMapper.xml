<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="fs.human.calopic.upload.dao.UploadDAO">

    <resultMap id="FoodMap" type="fs.human.calopic.upload.vo.UploadVO">
        <id     property="foodId"         column="FOOD_ID"/>
        <result property="foodName"       column="FOOD_NAME"/>
        <result property="foodWeight"     column="FOOD_WEIGHT"  jdbcType="VARCHAR"/>
        <result property="foodWeightGram" column="FOOD_WEIGHT_GRAM" jdbcType="NUMERIC"/>

        <result property="foodKcal"    column="FOOD_KCAL"    javaType="java.math.BigDecimal"/>
        <result property="foodCarbo"   column="FOOD_CARBO"   javaType="java.math.BigDecimal"/>
        <result property="foodProtein" column="FOOD_PROTEIN" javaType="java.math.BigDecimal"/>
        <result property="foodFat"     column="FOOD_FAT"     javaType="java.math.BigDecimal"/>
        <result property="foodSugar"   column="FOOD_SUGAR"   javaType="java.math.BigDecimal"/>
        <result property="foodNatrium" column="FOOD_NATRIUM" javaType="java.math.BigDecimal"/>
        <result property="yoloId" column="YOLO_ID" jdbcType="VARCHAR"/>
        <result property="qtyCoeffi" column="QTY_COEFFI" javaType="java.math.BigDecimal"/>
        <result property="imgUrl" column="IMG_URL" jdbcType="VARCHAR"/>

        <result property="userId"      column="USER_ID"/>
        <result property="userGender"  column="USER_GENDER"/>
    </resultMap>

    <!-- 문자열 FOOD_WEIGHT에서 숫자만 추출해 정수로 내려줌 -->
    <sql id="FoodColumns">
        FOOD_ID,
        FOOD_NAME,
        FOOD_KCAL,
        FOOD_CARBO,
        FOOD_PROTEIN,
        FOOD_FAT,
        FOOD_SUGAR,
        FOOD_NATRIUM,
        FOOD_WEIGHT,
        YOLO_ID,
        TO_NUMBER(REGEXP_SUBSTR(FOOD_WEIGHT, '\d+')) AS FOOD_WEIGHT_GRAM,
        QTY_COEFFI,
        IMG_URL
    </sql>

    <select id="selectAllFood" resultMap="FoodMap">
        SELECT
        <include refid="FoodColumns"/>
        FROM TB_FOOD
        ORDER BY FOOD_NAME
    </select>

    <!-- 단일 파라미터면 @Param("foodName") 권장 -->
    <select id="selectFoodByName" resultMap="FoodMap" parameterType="string">
        SELECT
        <include refid="FoodColumns"/>
        FROM TB_FOOD
        WHERE FOOD_NAME = #{value}
    </select>

    <select id="selectFoodByYoloIds" resultMap="FoodMap" parameterType="map">
        SELECT <include refid="FoodColumns"/>
        FROM TB_FOOD
        WHERE YOLO_ID IN
        <foreach collection="yoloIds" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
        <!-- 모델별 구분이 필요하면 아래 한 줄 추가
        AND YOLO_MODEL_ID = #{modelId}
        -->
    </select>

    <!-- 유저 성별 조회 -->
    <!-- 유저 성별 조회: USER_NAME → USER_ID 매핑 후 INFO 조인 -->
    <select id="selectUserGender" parameterType="string" resultMap="FoodMap">
        SELECT
        U.USER_ID                    AS USER_ID,
        TRIM(UI.USER_GENDER)         AS USER_GENDER
        FROM TB_USER U
        JOIN TB_USER_INFO UI ON UI.USER_ID = U.USER_ID
        WHERE U.USER_NAME = #{userId}   <!-- 프론트에서 넘기는 값 = 로그인 아이디(예: kimy9534) -->
    </select>



</mapper>
