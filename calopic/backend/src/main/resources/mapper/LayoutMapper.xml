<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="fs.human.calopic.layout.dao.LayoutDAO">

    <!-- 이메일로 user_id 조회 -->
    <select id="findUserIdByEmail" parameterType="string" resultType="long">
        SELECT user_id
        FROM tb_user
        WHERE user_email = #{email}
    </select>

    <!-- 로그인 아이디(문자형)로 user_id 조회 -->
    <select id="findUserIdByLoginId" parameterType="string" resultType="long">
        SELECT user_id
        FROM tb_user
        WHERE login_id = #{loginId}
    </select>

    <!-- ✅ 헤더용: userId로 userName 조회 -->
    <resultMap id="LayoutMap" type="fs.human.calopic.layout.vo.LayoutVO">
        <id property="userId" column="USER_ID"/>
        <result property="userName" column="USER_NAME"/>
        <result property="isAdmin"  column="IS_ADMIN"/>
    </resultMap>

    <select id="selectUserNameById" parameterType="long" resultMap="LayoutMap">
        SELECT USER_ID, USER_NAME, IS_ADMIN
        FROM TB_USER
        WHERE USER_ID = #{userId}
    </select>

</mapper>
