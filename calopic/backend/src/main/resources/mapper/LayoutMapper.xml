<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="fs.human.calopic.layout.dao.LayoutDAO">

    <!-- 이메일로 user_id 조회 -->
    <select id="findUserIdByEmail" parameterType="string" resultType="long">
        SELECT user_id
        FROM tb_user
        WHERE user_email = #{email}
    </select>

    <!-- 로그인 아이디(문자형)로 user_id 조회가 필요할 수도 있어서 보강 -->
    <select id="findUserIdByLoginId" parameterType="string" resultType="long">
        SELECT user_id
        FROM tb_user
        WHERE login_id = #{loginId}
    </select>

</mapper>
